# Copie para .env (não versionado). Nunca coloque credenciais reais neste arquivo.
APP_ENV=local
# Modo de autenticação: "dev" só é aceito com APP_ENV=local ou test. OIDC ainda não implementado.
AUTH_MODE=dev
DATABASE_URL=postgresql+psycopg://appsec:CHANGE_ME@localhost:5432/appsec_labs
RUNTIME_ADAPTER=fake
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=5
PROVISION_TIMEOUT_SECONDS=120
RECONCILE_INTERVAL_SECONDS=15
